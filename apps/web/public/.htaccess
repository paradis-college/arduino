# Apache configuration for Single Page Application (SPA)
# This file enables client-side routing for React Router by rewriting all
# non-file requests to index.html

# Enable the rewrite engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # If deploying to a subdirectory, uncomment and set the line below to your subdirectory path
  # For example, if deployed to /arduino/, use: RewriteBase /arduino/
  # RewriteBase /your-subdirectory/
  
  # Handle Authorization header for API requests (if needed in the future)
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  
  # Don't rewrite if the request is for an actual file
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  
  # Don't rewrite if the request is for an actual directory
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # Rewrite all other requests to index.html to support client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

# Optional: Set proper MIME types for common file extensions
<IfModule mod_mime.c>
  # JavaScript
  AddType application/javascript js mjs
  
  # CSS
  AddType text/css css
  
  # Images
  AddType image/svg+xml svg svgz
  AddType image/webp webp
  
  # Fonts
  AddType font/woff woff
  AddType font/woff2 woff2
</IfModule>

# Optional: Enable compression for better performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Optional: Set cache headers for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  
  # Fonts
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  
  # CSS and JavaScript
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  
  # HTML (should not be cached for SPA)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
