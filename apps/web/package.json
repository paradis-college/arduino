{
  "name": "@arduino-learn/web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate:manifest": "tsx scripts/generateLessonsManifest.ts",
    "dev": "npm run generate:manifest && vite",
    "build": "npm run generate:manifest && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "lint:test": "tsc --noEmit --project tsconfig.test.json"
  },
  "keywords": [
    "arduino",
    "learning",
    "education"
  ],
  "author": "Paradis College",
  "license": "MIT",
  "description": "Arduino learning platform - web frontend",
  "dependencies": {
    "p5": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.0.2",
    "@types/p5": "^1.7.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "gray-matter": "^4.0.3",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.6",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.14"
  }
